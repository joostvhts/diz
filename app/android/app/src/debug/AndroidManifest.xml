<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: allow plain http:// so the app can talk to a bridge
         running on a development machine (e.g. with tool/fake_bulb.dart).
         Release builds have no exemption and accept HTTPS only, validated
         against Android's normal trust store. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
