# Normalize text files to LF in the repository.
* text=auto

# Files that run or are read on Linux must keep LF even in Windows checkouts
# (core.autocrlf=true would otherwise turn them into CRLF and break them).
*.sh            text eol=lf
*.service       text eol=lf
*.env.example   text eol=lf
deploy/pkg/**   text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jar  binary
