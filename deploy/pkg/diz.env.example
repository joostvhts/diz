# Diz bridge configuration.
# After editing, apply with:  sudo systemctl restart diz-bridge

# Access token the app must send ("Authorization: Bearer <token>"), at least
# 16 characters. install.sh replaces CHANGEME with a random token on first
# install; the bridge refuses to start with the placeholder.
# Generate one yourself with: openssl rand -hex 32
DIZ_API_TOKEN=CHANGEME

# Address and port the HTTP API listens on. The Android app only talks HTTPS,
# so put a TLS reverse proxy in front (or use install.sh --tailscale-https,
# then 127.0.0.1 is enough here). Ports below 1024 won't work.
DIZ_HOST=0.0.0.0
DIZ_PORT=8787

# This machine's LAN IPv4 address. The lights are asked to push their status
# changes to it on UDP 38900, so the app sees changes made elsewhere (wall
# switch, remote) right away. install.sh fills it in; leave it out to disable push.
#DIZ_ADVERTISE_IP=192.168.1.5

# Where discovery probes are sent. 255.255.255.255 works on most networks.
# If no lights are found, try your subnet's broadcast address (for example
# 192.168.1.255), or set it to "off" and list your bulbs in DIZ_BULBS.
DIZ_BROADCAST=255.255.255.255

# Optional: bulb IP addresses to use in addition to discovery, comma-separated.
#DIZ_BULBS=192.168.1.50,192.168.1.51

# Seconds between automatic searches for new lights or changed IP addresses.
DIZ_DISCOVERY_INTERVAL=300

# Optional: serve a web UI (a `flutter build web` output) at /
#DIZ_WEB_ROOT=/opt/diz/web
