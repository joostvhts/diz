[Unit]
Description=Diz bridge - local control for WiZ lights
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Settings (port, discovery, ...). Created by install.sh, kept on upgrades.
EnvironmentFile=-/etc/diz/diz.env
ExecStart=/opt/diz/diz-bridge
Restart=always
RestartSec=3

# Runs as a throwaway system user; light names are kept in /var/lib/diz.
DynamicUser=yes
StateDirectory=diz

# Hardening: the bridge only needs the network and its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
