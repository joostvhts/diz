# Settings for compose.yaml. Copy to .env and replace every CHANGEME.
# The filled-in .env holds a secret: never commit it.

# LAN IPv4 address of the Docker host, as the lamps see it (e.g. 192.168.1.5).
# The UDP status port is published on this address only, and the bridge tells
# the lamps to push their status here.
LAN_IP=CHANGEME

# The lamps' IP addresses, comma-separated. They need fixed IPs (DHCP
# reservations). Example: 192.168.1.50,192.168.1.51,192.168.1.52
DIZ_BULBS=CHANGEME

# Access token the app must send as "Authorization: Bearer <token>".
# At least 16 characters; the bridge refuses to start with CHANGEME.
# Generate one with: openssl rand -hex 32
DIZ_API_TOKEN=CHANGEME
